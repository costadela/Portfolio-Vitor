<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <rect width="512" height="512" rx="100" fill="#13161A" />

  <text x="256" y="255" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        font-size="130" text-anchor="middle" letter-spacing="-3">
    <tspan font-weight="800" fill="#FFFFFF">V</tspan><tspan font-weight="500" fill="#B8C0CC">C</tspan>
  </text>

  <!-- Nome "Vitor" em destaque (Bold) -->
  <text x="256" y="360" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="46" font-weight="700" fill="#FFFFFF" text-anchor="middle" letter-spacing="1">Vitor</text>

  <!-- Sobrenome "Costadela" mais fino -->
  <text x="256" y="410" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="40" font-weight="400" fill="#9BA3AF" text-anchor="middle" letter-spacing="0.5">Costadela</text>
</svg>
